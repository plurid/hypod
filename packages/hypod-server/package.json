{
  "name": "@plurid/hypod",
  "version": "0.2.0",
  "description": "Self-hosted OCI Distribution registry with a Plurid admin interface",
  "keywords": [
    "oci",
    "distribution",
    "registry",
    "hypod"
  ],
  "author": "ly3xqhl8g9 <ly3xqhl8g9@plurid.com> (https://plurid.com)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/plurid/hypod"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    }
  },
  "bin": {
    "hypod": "./build/cli.mjs"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsdown",
    "build:client": "vite build",
    "dev": "vite --host 127.0.0.1",
    "start": "node build/cli.mjs serve",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:oci": "vitest run --config vitest.oci.config.ts"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@apollo/server": "catalog:",
    "@as-integrations/express5": "catalog:",
    "@plurid/hypod-contracts": "workspace:*",
    "@plurid/plurid-react": "catalog:",
    "@plurid/plurid-react-server": "catalog:",
    "express": "catalog:",
    "graphql": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "styled-components": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "supertest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
