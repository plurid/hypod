# Hypod 0.2 canonical configuration.
NODE_ENV=production

# Public Usage exposes only repositories explicitly marked public. Without all
# three owner settings below, it is intentionally read-only.
HYPOD_MODE=public
HYPOD_HOST=127.0.0.1
HYPOD_PORT=56565
HYPOD_EXTERNAL_URL=http://127.0.0.1:56565
HYPOD_DATA_ROOT=./data
HYPOD_TRUST_PROXY=false
HYPOD_LOG_LEVEL=info
HYPOD_SERVE_ADMIN=true
HYPOD_TOKEN_TTL_SECONDS=900

# Configure all three to permit owner writes in Public Usage, or set
# HYPOD_MODE=private to require authentication for every registry operation.
# Generate a token secret with: openssl rand -hex 32
# HYPOD_OWNER_IDENTONYM=owner
# HYPOD_OWNER_KEY=replace-with-a-long-random-password
# HYPOD_TOKEN_SECRET=replace-with-at-least-32-random-bytes
