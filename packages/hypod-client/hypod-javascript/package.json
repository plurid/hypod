{
  "name": "@plurid/hypod-client",
  "version": "0.2.0",
  "description": "Typed JavaScript client for Hypod",
  "keywords": [
    "hypod",
    "oci",
    "registry",
    "graphql"
  ],
  "author": "ly3xqhl8g9 <ly3xqhl8g9@plurid.com> (https://plurid.com)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/plurid/hypod"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./distribution/index.cjs",
  "module": "./distribution/index.mjs",
  "types": "./distribution/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./distribution/index.d.mts",
        "default": "./distribution/index.mjs"
      },
      "require": {
        "types": "./distribution/index.d.cts",
        "default": "./distribution/index.cjs"
      }
    }
  },
  "files": [
    "distribution",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@plurid/hypod-contracts": "workspace:*",
    "graphql": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
